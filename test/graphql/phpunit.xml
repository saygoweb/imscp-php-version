<?xml version="1.0" encoding="UTF-8"?>
<phpunit xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:noNamespaceSchemaLocation="https://schema.phpunit.de/9.6/phpunit.xsd"
         bootstrap="bootstrap.php"
         colors="true"
         failOnWarning="true"
         failOnRisky="true"
         beStrictAboutOutputDuringTests="true">
    <!--
        Needs the panel bootstrapped and a database - the SGW_GraphQL plugin's
        AuthzTestCase skips rather than fails off the box, exactly as its own
        integration suite does.
    -->
    <testsuites>
        <testsuite name="graphql">
            <directory>.</directory>
        </testsuite>
    </testsuites>
    <!--
        What a coverage run (the GraphQL job in .github/workflows/test.yml)
        measures: the plugin's own PHP source, not its tests or tooling.
    -->
    <coverage>
        <include>
            <directory suffix=".php">../../GraphQL</directory>
            <directory suffix=".php">../../frontend</directory>
            <file>../../SGW_PhpVersion.php</file>
        </include>
    </coverage>
</phpunit>
